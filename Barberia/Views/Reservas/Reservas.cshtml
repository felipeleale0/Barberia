@model IEnumerable<Barberia.Models.Domain.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<h1>Reservas</h1>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Turno.Fecha)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Turno.Hora)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Turno)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Usuario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Servicio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CostoTotal)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Turno.Fecha)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Turno.Hora)
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.Turno.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Usuario.NombreUsuario)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Estado.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Servicio.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CostoTotal)
            </td>
                <td>
                    <div style="display:flex; gap:10px; align-items:center;">
                        <form asp-action="Cancelar"
                              asp-route-id="@item.Id"
                              method="post">
                            <button type="submit"
                                    style="
                        background:#dc3545;
                        color:white;
                        border:none;
                        padding:10px 16px;
                        border-radius:8px;
                        font-weight:600;
                        cursor:pointer;">
                                🗑 Cancelar
                            </button>
                        </form>

                        <form asp-action="Reagendar"
                              asp-route-id="@item.Id"
                              method="post">
                            <button type="submit"
                                    style="
                        background:#0d6efd;
                        color:white;
                        border:none;
                        padding:10px 16px;
                        border-radius:8px;
                        font-weight:600;
                        cursor:pointer;">
                                ✏️ Reagendar
                            </button>
                        </form>
                    </div>

            </td>
        </tr>
}
    </tbody>
</table>
