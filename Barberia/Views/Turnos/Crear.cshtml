@model Barberia.Models.Domain.Turno

@{
    var empleados = ViewBag.Empleados as List<Barberia.Models.Domain.Empleado>;
}

<h2>Nuevo turno</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Fecha</label>
        <input asp-for="Fecha" type="date" class="form-control" />
        <span asp-validation-for="Fecha" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Hora</label>
        <input asp-for="Hora" type="time" class="form-control" />
        <span asp-validation-for="Hora" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Barbero</label>
        <select asp-for="EmpleadoId" class="form-select">
            <option value="">-- Seleccionar --</option>
            @foreach (var e in empleados)
            {
                <option value="@e.Id">
                    @e.Persona.Nombre @e.Persona.Apellido
                </option>
            }
        </select>
        <span asp-validation-for="EmpleadoId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
</form>
