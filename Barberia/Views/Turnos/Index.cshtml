@model IEnumerable<Barberia.Models.Domain.Turno>

<h2>Turnos</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo turno</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Barbero</th>
            <th>Disponible</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Fecha.ToShortDateString()</td>
                <td>@t.Hora</td>
                <td>@t.Empleado.Persona.Nombre @t.Empleado.Persona.Apellido</td>
                <td>@(t.EstaDisponible ? "Sí" : "No")</td>
            </tr>
        }
    </tbody>
</table>
