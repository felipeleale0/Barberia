@model Barberia.Models.ViewModels.TurnoDisponibleViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/admin/users.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shift/shift.css" asp-append-version="true" />
}

@{
    int? reservaId = int.TryParse(Context.Request.Query["reservaId"], out var tmp)
        ? tmp
        : null;
}

<div class="users-page">
    <div class="users-header">
        <div>
            <h2>Reservar turno</h2>
            <p class="text-muted">
                Elegí la fecha del turno y reservá uno de los horarios disponibles.
            </p>
        </div>

        <div class="users-header-actions">
            <form asp-action="Index" method="get" class="filters-form">
                <input type="date"
                       name="fecha"
                       value="@Model.FechaSeleccionada.ToString("yyyy-MM-dd")"
                       class="date-input" />
                <button type="submit" class="btn btn-filter">Ver turnos</button>
            </form>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success">@TempData["Ok"]</div>
    }

    @if (!Model.Turnos.Any())
    {
        <p class="users-empty">No hay turnos para esta fecha.</p>
    }
    else
    {
        <div class="users-table-wrapper">
            <table class="users-table">
                <thead>
                    <tr>
                        <th>Hora</th>
                        <th>Barbero</th>
                        <th>Servicio</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Turnos)
                    {
                        <tr>
                            <td>@t.Hora</td>
                            <td>@t.EmpleadoNombre</td>
                            <td>
                                <form asp-action="Reservar" method="post">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="turnoId" value="@t.TurnoId" />

                                    @if (reservaId != null)
                                    {
                                        <input type="hidden" name="reservaAnteriorId" value="@reservaId" />
                                    }

                                    <select name="servicioId"
                                            class="select-filter @(t.EstaDisponible ? "" : "select-disabled")"
                                            @(t.EstaDisponible ? "" : "disabled")>
                                        @foreach (var s in t.Servicios)
                                        {
                                            <option value="@s.Id">@s.Nombre (@s.Precio.ToString("C"))</option>
                                        }
                                    </select>

                                    @if (t.EstaDisponible)
                                    {
                                        <button type="submit" class="btn-reservar-turno">Reservar</button>
                                    }
                                </form>
                            </td>
                            <td>
                                @if (t.EstaDisponible)
                                {
                                    <span class="pill pill-success">Disponible</span>
                                }
                                else
                                {
                                    <span class="pill pill-danger">Ocupado</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
